<Window x:Class="urhajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:urhajok"
        mc:Ignorable="d"
        Title="Őrhajók" Height="500" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0"  Margin="0,0,0,0">
            <Button Content="Adatok betöltése" Click="AdatokBetoltese" Margin="10,5"/>

        </StackPanel>


        <DataGrid x:Name="datagrid" Grid.Column="1" AutoGenerateColumns="True" Margin="10"/>
    </Grid>
</Window>